# Skill ZIPs, the upstream manifest and the delivery package verify exact bytes, including
# original EOLs. Without -text, a CRLF checkout changes delivery/FILES.json on rebuild.
graduation-thesis-workflow/skills/graduation-thesis/** -text
graduation-thesis-workflow/LICENSE -text
graduation-thesis-workflow/** -text whitespace=cr-at-eol
*.zip -text
*.png -text
*.gif -text

# Preserve the personal Windows launchers and exported metadata byte for byte.
*/profile/** -text whitespace=cr-at-eol
LibreTV/packages/*.json -text whitespace=cr-at-eol
