#pragma code_page(65001)
1 ICON "assets/daozai.ico"
1 VERSIONINFO
 FILEVERSION 0,6,50,0
 PRODUCTVERSION 0,6,50,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            ; 与上游正式 v0.6.50 同号但带个人版标识，便于安装后核对不是官方原包。
            VALUE "FileDescription", "岛仔 个人版"
            VALUE "InternalName", "Daozai"
            VALUE "OriginalFilename", "daozai.exe"
            VALUE "ProductName", "岛仔 Daozai 个人版"
            VALUE "ProductVersion", "0.6.50"
            VALUE "FileVersion", "0.6.50"
        END
    END
    BLOCK "VarFileInfo"
